prefix=@QT_PREFIX@
exec_prefix=@QT_PREFIX@
libdir=@QT_PREFIX@/lib
includedir=@QT_PREFIX@/include
bindir=@QT_PREFIX@/libexec
libexecdir=@QT_PREFIX@/libexec
host_bins=@QT_PREFIX@/bin
qt_host_bins=@QT_PREFIX@/bin

Name: Qt6Qml
Description: Qt6 Qml module
Version: @QT_VERSION@
Requires.private: Qt6Core Qt6Network
Libs: -L@QT_PREFIX@/lib -lQt6Qml
Cflags: -I@QT_PREFIX@/include -I@QT_PREFIX@/include/QtQml -I@QT_PREFIX@/include/QtQml/@QT_VERSION@ -I@QT_PREFIX@/include/QtQml/@QT_VERSION@/QtQml


