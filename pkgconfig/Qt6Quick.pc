prefix=@QT_PREFIX@
exec_prefix=@QT_PREFIX@
libdir=@QT_PREFIX@/lib
includedir=@QT_PREFIX@/include
bindir=@QT_PREFIX@/libexec
libexecdir=@QT_PREFIX@/libexec
host_bins=@QT_PREFIX@/bin
qt_host_bins=@QT_PREFIX@/bin

Name: Qt6Quick
Description: Qt6 Quick module
Version: @QT_VERSION@
Requires.private: Qt6Core Qt6Qml Qt6Gui
Libs: -L@QT_PREFIX@/lib -lQt6Quick
Cflags: -I@QT_PREFIX@/include -I@QT_PREFIX@/include/QtQuick -I@QT_PREFIX@/include/QtQuick/@QT_VERSION@ -I@QT_PREFIX@/include/QtQuick/@QT_VERSION@/QtQuick


