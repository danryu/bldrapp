# Jitsi Meet configuration
HTTP_PORT=8000
HTTPS_PORT=30443
TZ=America/Los_Angeles
ENABLE_LETSENCRYPT=0
JICOFO_COMPONENT_SECRET=s3cr3tjicofo
JICOFO_AUTH_PASSWORD=focuspassword
JVB_AUTH_PASSWORD=jvbpassword
JVB_AUTH_USER=jvb
ENABLE_PREJOIN_PAGE=0
PUBLIC_URL=https://localhost:${HTTPS_PORT}

# Enable WebSockets
ENABLE_COLIBRI_WEBSOCKET=1
ENABLE_XMPP_WEBSOCKET=1

# XMPP Configuration
XMPP_DOMAIN=localhost
XMPP_AUTH_DOMAIN=auth.localhost
XMPP_GUEST_DOMAIN=guest.localhost
XMPP_MUC_DOMAIN=conference.localhost
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.localhost
XMPP_RECORDER_DOMAIN=recorder.localhost
XMPP_SERVER=xmpp.meet.jitsi

# JVB Configuration
JVB_CC_TRUST_BWE=false
JVB_PORT=30000

# Codec configuration (matching production)
ENABLE_CODEC_VP8=false
ENABLE_CODEC_VP9=false
ENABLE_CODEC_H264=true
ENABLE_CODEC_AV1=false

# Other settings
